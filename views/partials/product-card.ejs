<article class="product-card">
  <a href="/shop/<%= producto.id %>" class="card-img-wrap">
    <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>" loading="lazy" />
    <span class="badge"><%= producto.categoria %></span>
  </a>
  <div class="card-body">
    <p class="artisan"><%= producto.artesano %></p>
    <h3><a href="/shop/<%= producto.id %>"><%= producto.nombre %></a></h3>
    <div class="card-foot">
      <span class="price">$<%= producto.precio.toFixed(2) %></span>
      <button class="add-btn" data-id="<%= producto.id %>">+ Añadir</button>
    </div>
  </div>
</article>